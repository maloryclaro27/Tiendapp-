# Storefront public API URL used by the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Internal API URL used by Next.js server components
TIENDAPP_INTERNAL_API_URL=http://localhost:8080/api/v1

# Admin panel URL used by the storefront header
NEXT_PUBLIC_ADMIN_URL=http://localhost:8080/admin
